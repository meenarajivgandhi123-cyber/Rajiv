{
  "entities": {
    "IntegrationZone": {
      "title": "IntegrationZone",
      "description": "Geographical zone and region grouping contract broiler farms for daily reports.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "zoneCode": { "type": "string" },
        "zoneName": { "type": "string" },
        "region": { "type": "string" },
        "supervisorName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "zoneCode", "zoneName", "region", "createdAt", "updatedAt"]
    },
    "Farmer": {
      "title": "Farmer",
      "description": "Contract broiler grower farm profile, zone assignment, banking details, and shed occupancy status (active, closing, empty, cancelled).",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "farmCode": { "type": "string" },
        "farmerName": { "type": "string" },
        "farmName": { "type": "string" },
        "phone": { "type": "string" },
        "village": { "type": "string" },
        "tehsil": { "type": "string" },
        "region": { "type": "string" },
        "farmType": { "type": "string" },
        "zoneId": { "type": "string" },
        "zoneName": { "type": "string" },
        "panNumber": { "type": "string" },
        "aadhaarNumber": { "type": "string" },
        "accountNumber": { "type": "string" },
        "bankName": { "type": "string" },
        "ifscCode": { "type": "string" },
        "accountType": { "type": "string" },
        "shedType": { "type": "string", "enum": ["EC", "Open-Sided", "Semi-EC"] },
        "shedCapacity": { "type": "integer" },
        "totalSqft": { "type": "integer" },
        "growingRatePerKg": { "type": "number" },
        "farmStatus": { "type": "string", "enum": ["active", "closing", "empty", "cancelled"] },
        "currentBatchId": { "type": "string" },
        "currentBatchCode": { "type": "string" },
        "cancelReason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "farmCode",
        "farmerName",
        "phone",
        "village",
        "shedType",
        "shedCapacity",
        "growingRatePerKg",
        "farmStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "FlockBatch": {
      "title": "FlockBatch",
      "description": "Broiler batch placed at a contract farm, tracking live performance, lifting, and final GC Closed settlement.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "batchCode": { "type": "string" },
        "farmerId": { "type": "string" },
        "farmerName": { "type": "string" },
        "farmName": { "type": "string" },
        "farmCode": { "type": "string" },
        "region": { "type": "string" },
        "zoneName": { "type": "string" },
        "weekNumber": { "type": "string" },
        "challanNo": { "type": "string" },
        "breed": { "type": "string" },
        "chicksPlaced": { "type": "integer" },
        "freeChicks": { "type": "integer" },
        "placementEpochDay": { "type": "integer" },
        "targetMarketAgeDays": { "type": "integer" },
        "targetAvgWeightKg": { "type": "number" },
        "standardFcr": { "type": "number" },
        "growingRatePerKg": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "closing", "closed"] },
        "cumulativeMortality": { "type": "integer" },
        "cumulativeFeedKg": { "type": "number" },
        "latestAvgWeightGrams": { "type": "number" },
        "liftedBirds": { "type": "integer" },
        "liftedWeightKg": { "type": "number" },
        "returnedFeedKg": { "type": "number" },
        "settlementPayout": { "type": "number" },
        "closingNotes": { "type": "string" },
        "closedEpochDay": { "type": "integer" },
        "gcDetails": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "batchCode",
        "farmerId",
        "farmerName",
        "farmCode",
        "breed",
        "chicksPlaced",
        "freeChicks",
        "placementEpochDay",
        "targetMarketAgeDays",
        "targetAvgWeightKg",
        "standardFcr",
        "growingRatePerKg",
        "status",
        "cumulativeMortality",
        "cumulativeFeedKg",
        "latestAvgWeightGrams",
        "liftedBirds",
        "liftedWeightKg",
        "returnedFeedKg",
        "settlementPayout",
        "closedEpochDay",
        "createdAt",
        "updatedAt"
      ]
    },
    "DailyLog": {
      "title": "DailyLog",
      "description": "Daily flock mortality, feed consumption, body weight sampling, loose birds, feeder stock, and shed telemetry.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "batchId": { "type": "string" },
        "farmerId": { "type": "string" },
        "dayNumber": { "type": "integer" },
        "logEpochDay": { "type": "integer" },
        "mortalityCount": { "type": "integer" },
        "cullCount": { "type": "integer" },
        "feedConsumedKg": { "type": "number" },
        "avgWeightGrams": { "type": "number" },
        "shedTempCelsius": { "type": "number" },
        "looseBirds": { "type": "integer" },
        "feederStock": { "type": "integer" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "batchId",
        "farmerId",
        "dayNumber",
        "logEpochDay",
        "mortalityCount",
        "cullCount",
        "feedConsumedKg",
        "avgWeightGrams",
        "shedTempCelsius",
        "createdAt",
        "updatedAt"
      ]
    },
    "FeedDispatch": {
      "title": "FeedDispatch",
      "description": "Feed bag dispatch record issued to a destination broiler farm and active batch.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "batchId": { "type": "string" },
        "farmerId": { "type": "string" },
        "farmerName": { "type": "string" },
        "farmCode": { "type": "string" },
        "farmName": { "type": "string" },
        "batchCode": { "type": "string" },
        "feedType": { "type": "string", "enum": ["Pre-Starter", "Starter", "Grower", "Finisher"] },
        "bagsCount": { "type": "integer" },
        "weightKg": { "type": "number" },
        "unitRate": { "type": "number" },
        "rateBasis": { "type": "string", "enum": ["bag", "kg"] },
        "totalAmount": { "type": "number" },
        "challanNo": { "type": "string" },
        "vehicleNo": { "type": "string" },
        "remarks": { "type": "string" },
        "dispatchEpochDay": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "batchId",
        "farmerId",
        "farmerName",
        "batchCode",
        "feedType",
        "bagsCount",
        "weightKg",
        "challanNo",
        "dispatchEpochDay",
        "createdAt",
        "updatedAt"
      ]
    },
    "BirdSale": {
      "title": "BirdSale",
      "description": "Daily live bird lifting and sales challan tracking quantity sold, sale price, and customer details.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "batchId": { "type": "string" },
        "farmerId": { "type": "string" },
        "farmerName": { "type": "string" },
        "farmCode": { "type": "string" },
        "batchCode": { "type": "string" },
        "buyerName": { "type": "string" },
        "buyerPhone": { "type": "string" },
        "vehicleNo": { "type": "string" },
        "challanNo": { "type": "string" },
        "remarks": { "type": "string" },
        "birdsSold": { "type": "integer" },
        "totalWeightKg": { "type": "number" },
        "ageDays": { "type": "integer" },
        "avgWeightKg": { "type": "number" },
        "ratePerKg": { "type": "number" },
        "saleAmount": { "type": "number" },
        "saleEpochDay": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "batchId",
        "farmerId",
        "farmerName",
        "farmCode",
        "batchCode",
        "buyerName",
        "challanNo",
        "birdsSold",
        "totalWeightKg",
        "ratePerKg",
        "saleAmount",
        "saleEpochDay",
        "createdAt",
        "updatedAt"
      ]
    },
    "FeedTransfer": {
      "title": "FeedTransfer",
      "description": "Inter-farm feed bag transfer from one active/closing batch to another.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fromBatchId": { "type": "string" },
        "fromFarmerId": { "type": "string" },
        "fromFarmerName": { "type": "string" },
        "fromFarmCode": { "type": "string" },
        "fromBatchCode": { "type": "string" },
        "toBatchId": { "type": "string" },
        "toFarmerId": { "type": "string" },
        "toFarmerName": { "type": "string" },
        "toFarmCode": { "type": "string" },
        "toBatchCode": { "type": "string" },
        "feedType": { "type": "string", "enum": ["Pre-Starter", "Starter", "Grower", "Finisher"] },
        "bagsCount": { "type": "integer" },
        "weightKg": { "type": "number" },
        "transferRef": { "type": "string" },
        "remarks": { "type": "string" },
        "transferEpochDay": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "fromBatchId",
        "fromFarmerId",
        "fromFarmerName",
        "fromFarmCode",
        "fromBatchCode",
        "toBatchId",
        "toFarmerId",
        "toFarmerName",
        "toFarmCode",
        "toBatchCode",
        "feedType",
        "bagsCount",
        "weightKg",
        "transferRef",
        "transferEpochDay",
        "createdAt",
        "updatedAt"
      ]
    },
    "Operator": {
      "title": "Operator",
      "description": "Organization staff account with role (super_admin, admin, user), employee code, and salted SHA-256 password hash.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "empCode": { "type": "string" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "admin", "user"] },
        "passwordHash": { "type": "string" },
        "isActive": { "type": "boolean" },
        "allowPreviousDateEntry": { "type": "boolean" },
        "mappedEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "empCode",
        "fullName",
        "role",
        "passwordHash",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "MedicineEntry": {
      "title": "MedicineEntry",
      "description": "Medicine, vaccine, supplement, or sanitizer issue entry linked to an active or closing broiler batch.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "batchId": { "type": "string" },
        "farmerId": { "type": "string" },
        "farmerName": { "type": "string" },
        "farmCode": { "type": "string" },
        "batchCode": { "type": "string" },
        "medicineName": { "type": "string" },
        "category": { "type": "string", "enum": ["Vaccine", "Antibiotic", "Supplement / Vitamin", "Sanitizer", "Other"] },
        "dosageOrQty": { "type": "string" },
        "totalCost": { "type": "number" },
        "invoiceOrSlipNo": { "type": "string" },
        "remarks": { "type": "string" },
        "entryEpochDay": { "type": "integer" },
        "enteredByEmpCode": { "type": "string" },
        "enteredByName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "batchId",
        "farmerId",
        "farmerName",
        "farmCode",
        "batchCode",
        "medicineName",
        "category",
        "totalCost",
        "invoiceOrSlipNo",
        "entryEpochDay",
        "createdAt",
        "updatedAt"
      ]
    },
    "MedicineCatalogItem": {
      "title": "MedicineCatalogItem",
      "description": "Master medicine and vaccine catalog item storing code, medicine name, packing, unit, rate, and per-kg/ltr rate.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "medicineCode": { "type": "string" },
        "medicineName": { "type": "string" },
        "category": { "type": "string", "enum": ["Vaccine", "Antibiotic", "Supplement / Vitamin", "Sanitizer", "Other"] },
        "packing": { "type": "number" },
        "unit": { "type": "string" },
        "rate": { "type": "number" },
        "perKgOrLtr": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "medicineCode",
        "medicineName",
        "category",
        "packing",
        "rate",
        "perKgOrLtr",
        "createdAt",
        "updatedAt"
      ]
    },
    "KmDailyEntry": {
      "title": "KmDailyEntry",
      "description": "Daily odometer reading (start KM, end KM, total KM, visited farms) logged per field operator.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "operatorId": { "type": "string" },
        "empCode": { "type": "string" },
        "operatorName": { "type": "string" },
        "entryEpochDay": { "type": "integer" },
        "monthKey": { "type": "string" },
        "startKm": { "type": "number" },
        "endKm": { "type": "number" },
        "totalKm": { "type": "number" },
        "visitedFarms": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "empCode",
        "operatorName",
        "entryEpochDay",
        "monthKey",
        "startKm",
        "endKm",
        "totalKm",
        "createdAt",
        "updatedAt"
      ]
    },
    "KmClaim": {
      "title": "KmClaim",
      "description": "Once-per-month aggregated travel claim submitted by an employee for Admin/Super Admin approval.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "operatorId": { "type": "string" },
        "empCode": { "type": "string" },
        "operatorName": { "type": "string" },
        "claimMonthKey": { "type": "string" },
        "claimMonthLabel": { "type": "string" },
        "claimEpochDay": { "type": "integer" },
        "dailyEntriesCount": { "type": "integer" },
        "startKm": { "type": "number" },
        "endKm": { "type": "number" },
        "totalKm": { "type": "number" },
        "ratePerKm": { "type": "number" },
        "claimAmount": { "type": "number" },
        "visitedFarms": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewedByEmpCode": { "type": "string" },
        "reviewedByName": { "type": "string" },
        "reviewRemarks": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "empCode",
        "operatorName",
        "claimMonthKey",
        "claimMonthLabel",
        "claimEpochDay",
        "dailyEntriesCount",
        "startKm",
        "endKm",
        "totalKm",
        "ratePerKm",
        "claimAmount",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/zones/{zoneId}": {
      "schema": { "$ref": "#/entities/IntegrationZone" },
      "description": "User-scoped operational zones and regions for zone-wise daily reports"
    },
    "/users/{userId}/operators/{operatorId}": {
      "schema": { "$ref": "#/entities/Operator" },
      "description": "User-scoped employee login accounts for Super Admin, Admin, and User roles"
    },
    "/users/{userId}/farmers/{farmerId}": {
      "schema": { "$ref": "#/entities/Farmer" },
      "description": "User-scoped contract farmer and farm shed records"
    },
    "/users/{userId}/batches/{batchId}": {
      "schema": { "$ref": "#/entities/FlockBatch" },
      "description": "User-scoped broiler flock batches"
    },
    "/users/{userId}/dailyLogs/{logId}": {
      "schema": { "$ref": "#/entities/DailyLog" },
      "description": "User-scoped daily flock mortality and feed logs"
    },
    "/users/{userId}/feedDispatches/{dispatchId}": {
      "schema": { "$ref": "#/entities/FeedDispatch" },
      "description": "User-scoped feed bag dispatches"
    },
    "/users/{userId}/birdSales/{saleId}": {
      "schema": { "$ref": "#/entities/BirdSale" },
      "description": "User-scoped live bird sales and lifting challans"
    },
    "/users/{userId}/feedTransfers/{transferId}": {
      "schema": { "$ref": "#/entities/FeedTransfer" },
      "description": "User-scoped inter-farm feed bag transfers"
    },
    "/users/{userId}/medicineEntries/{entryId}": {
      "schema": { "$ref": "#/entities/MedicineEntry" },
      "description": "User-scoped medicine, vaccine, and supplement issue ledger entries"
    },
    "/users/{userId}/medicinesCatalog/{itemId}": {
      "schema": { "$ref": "#/entities/MedicineCatalogItem" },
      "description": "User-scoped master medicine and vaccine price/packing catalog"
    },
    "/users/{userId}/kmEntries/{entryId}": {
      "schema": { "$ref": "#/entities/KmDailyEntry" },
      "description": "User-scoped daily KM odometer logs per employee"
    },
    "/users/{userId}/kmClaims/{claimId}": {
      "schema": { "$ref": "#/entities/KmClaim" },
      "description": "User-scoped monthly KM travel claims (strictly once per employee per calendar month)"
    }
  }
}
